FROM ubuntu:26.04

# default to UTF-8 file.encoding
ENV LANG=en_US.UTF-8

RUN apt-get update -y \
  && apt-get install -y --no-install-recommends \
  locales \
  tzdata \
  bear \
  binutils-dev \
  build-essential \
  ca-certificates \
  gawk \
  gdb \
  gcc-14 \
  g++-14 \
  gfortran \
  git \
  libbz2-dev \
  libcairo2-dev \
  libcurl4-openssl-dev \
  libgrpc++-dev \
  libgtk2.0-dev \
  libicu-dev \
  libjpeg-dev \
  liblzma-dev \
  libpango1.0-dev \
  libpng-dev \
  libreadline-dev \
  libstdc++-14-dev \
  libssl-dev \
  libtiff5-dev \
  libuv1-dev \
  libx11-dev \
  libxt-dev \
  libxxhash-dev \
  libzmq3-dev \
  rr \
  rsync \
  software-properties-common \
  time \
  wget \
  xvfb \
  zlib1g-dev \
  && echo "$LANG" >> /etc/locale.gen \
  && locale-gen "$LANG" \
  && update-locale LANG="$LANG" \
  && rm -rf /var/lib/apt/lists/*

# Pin gcc to 14 even though 26.04 ships 15 as its default: the stencils are
# extracted from compiled machine code, so the compiler version is part of RCP's
# ABI (no_callee_saved_registers, register pinning, epilogue shape) and is not a
# free variable. Moving the distro forward while holding the compiler still also
# keeps benchmark numbers attributable to the OS change alone.
RUN update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-14 14

# install vanilla R -- the baseline the bc benchmarks run on.
#
# Two invariants keep the bc-vs-rcp ratio a measurement of the JIT rather than
# of incidental differences between the two R builds:
#
#  1. Same version. R_VERSION must match the R that rsh vendors in external/R
#     (see its VERSION file). It is pinned here rather than derived from that
#     file because this layer is deliberately keyed on nothing -- that is what
#     keeps the expensive vanilla R build cached across rsh and rcp commits.
#     The pin is therefore checked instead: Dockerfile.rcp-rsh asserts the two
#     versions agree once the vendored sources are on hand, so bumping the
#     vendored R without bumping R_VERSION fails the build rather than quietly
#     skewing the numbers (which is how a 4.3.2 baseline once ended up measured
#     against an R-devel snapshot).
#  2. Same compilation. The flags below mirror what rsh's tools/build-gnur.sh
#     exports for the RCP R on Linux: -g -O2 for C, C++ and the preprocessor,
#     plain ./configure with no extra args, and the gcc-14 selected above. The
#     one intended difference is -DRCP, which build-gnur.sh adds to CPPFLAGS for
#     the RCP variant and which must not appear here. R's configure would settle
#     on -g -O2 for gcc by itself, but setting it explicitly pins the parity
#     instead of leaving it to an autoconf default.
ARG R_VERSION=4.5.2
RUN set -eux \
  && cd /tmp \
  && wget https://cran.r-project.org/src/base/R-${R_VERSION%%.*}/R-${R_VERSION}.tar.gz \
  && tar -xzf R-${R_VERSION}.tar.gz \
  && cd R-${R_VERSION} \
  && CFLAGS="-g -O2" CXXFLAGS="-g -O2" CPPFLAGS="-g -O2" \
     ./configure --prefix=/R-vanilla \
  && make -j$(nproc) \
  && make install \
  && cd / \
  && rm -rf /tmp/R-${R_VERSION}* \
  && /R-vanilla/bin/R -e 'install.packages("microbenchmark", repos="https://cloud.r-project.org")'
