include ../common.mk

# Select the copy-and-patch (RCP) variant of the R headers (rcp_exec_ptrs,
# rcp_sharedmem_ptrs, rcpEval_locals, R_RcpFree, ...). This MUST go through
# PKG_CPPFLAGS, not the `CFLAGS += -DRCP` in common.mk: `R CMD INSTALL` sets
# CFLAGS itself and ignores a Makevars-level `CFLAGS +=`, so common.mk's define
# reaches the stencils/shared libs (plain `make`) but NOT the package compile.
# PKG_CPPFLAGS is applied to both C and C++ (rcp_exceptions.cpp) sources.
PKG_CPPFLAGS += -DRCP

# Keep `Rinlinedfuns.h` on GNU inline semantics. Under C99 semantics `INLINE_FUN` is a bare
# `inline`, and since `Rinternals.h` also declares each of those functions without `inline`, every
# translation unit emits its own external copy of `CAR`, `DATAPTR`, ... and they collide when the
# package is linked. This has to be a flag rather than a `#define` like the one in
# `client/rsh/src/common2c/rsh_utils.h`: `stencils-runtime.c` and the generated
# `stencils-build/stencils_data.c` both include <Rinternals.h> before any of our headers.
PKG_CPPFLAGS += -DC99_INLINE_SEMANTICS=0

# Record header dependencies (see common.mk for why). This has to go through PKG_CPPFLAGS for the
# same reason as -DRCP above: common.mk's `CFLAGS +=` reaches the plain-make subdirectories but not
# this package compile.
PKG_CPPFLAGS += -MMD -MP

RCP_GIT_COMMIT := $(shell git -C $(ROOT_DIR) rev-parse --short HEAD 2>/dev/null || echo NA)
PKG_CFLAGS += -DRCP_GIT_COMMIT=\"$(RCP_GIT_COMMIT)\"

OPENMP ?= 0

ifneq ($(OPENMP),0)
  PKG_CFLAGS += -fopenmp
  PKG_LIBS += -fopenmp
endif

RCP_COMPILE_PROMISES ?= 0
PKG_CFLAGS += -DRCP_COMPILE_PROMISES=$(RCP_COMPILE_PROMISES)

# Use the crbcc package as bc-compiler backend, if available
RCP_CRBCC_DEFAULT ?= 0
PKG_CFLAGS += -DRCP_CRBCC_DEFAULT=$(RCP_CRBCC_DEFAULT)

# Per-stencil profiling (see common.mk). common.mk's `CFLAGS += -DPROFILE_STENCILS'
# reaches the stencils/shared-lib (plain make) but NOT this package compile of
# compile.c, which holds the stencil_profile_info[] storage and C_rcp_get_profiling.
PROFILE_STENCILS ?= 0
ifneq ($(PROFILE_STENCILS),0)
  PKG_CFLAGS += -DPROFILE_STENCILS
endif

PKG_CFLAGS += $(DEFINE_FLAGS)
PKG_CFLAGS += -I$(RSH_HOME)/src/bc2c
PKG_CFLAGS += -DALIGNMENT_LABELS=$(ALIGNMENT_LABELS)
PKG_CFLAGS += -DALIGNMENT_JUMPS=$(ALIGNMENT_JUMPS)
PKG_CFLAGS += -DALIGNMENT_LOOPS=$(ALIGNMENT_LOOPS)

ifeq ($(strip $(MCMODEL)),medium)
  PKG_CFLAGS += -DMCMODEL_SMALL
endif

ifneq ($(SPECIALIZE_STEPFOR),0)
  PKG_CFLAGS += -DSTEPFOR_SPECIALIZE
endif

ifneq ($(SPECIALIZE_SWITCH),0)
  PKG_CFLAGS += -DSWITCH_SPECIALIZE
endif

ifneq ($(SPECIALIZE_MAKEPROM),0)
  PKG_CFLAGS += -DMAKEPROM_SPECIALIZE
endif

ifneq ($(SPECIALIZE_MAKECLOSURE),0)
  PKG_CFLAGS += -DMAKECLOSURE_SPECIALIZE
endif

# Assume the bytecode object is always valid: turns BC_ERROR checks into ASSUME
# (hard-aborting in debug, optimized away in release). Off by default since it
# removes the graceful error path for corrupt/unexpected bytecode.
ASSUME_VALID_BC ?= 1
ifneq ($(ASSUME_VALID_BC),0)
  PKG_CFLAGS += -DASSUME_VALID_BC
endif

# Decompile promises that are going to be faster in AST than would be in BC
# Needed for trivial promise inlining
DECOMPILE_TRIVIAL_PROMISES ?= 1
ifneq ($(DECOMPILE_TRIVIAL_PROMISES),0)
  PKG_CFLAGS += -DDECOMPILE_TRIVIAL_PROMISES
endif

$(info --- CONFIG ---)
$(info RSH_HOME=$(RSH_HOME))
$(info R_HOME=$(R_HOME))
$(info RCP_GIT_COMMIT=$(RCP_GIT_COMMIT))
$(info OPENMP=$(OPENMP))
$(info ASSUME_VALID_BC=$(ASSUME_VALID_BC))
$(info PROFILE_STENCILS=$(PROFILE_STENCILS))
$(info RCP_CRBCC_DEFAULT=$(RCP_CRBCC_DEFAULT))
$(info RCP_COMPILE_PROMISES=$(RCP_COMPILE_PROMISES))
$(info DECOMPILE_TRIVIAL_PROMISES=$(DECOMPILE_TRIVIAL_PROMISES))
$(info ALIGNMENT_LABELS=$(ALIGNMENT_LABELS))
$(info ALIGNMENT_JUMPS=$(ALIGNMENT_JUMPS))
$(info ALIGNMENT_LOOPS=$(ALIGNMENT_LOOPS))
$(info MCMODEL=$(MCMODEL))
$(info SPECIALIZE_STEPFOR=$(SPECIALIZE_STEPFOR))
$(info SPECIALIZE_SWITCH=$(SPECIALIZE_SWITCH))
$(info SPECIALIZE_MAKEPROM=$(SPECIALIZE_MAKEPROM))
$(info SPECIALIZE_MAKECLOSURE=$(SPECIALIZE_MAKECLOSURE))
$(info --------------)

STENCILS_BUILD_DIR = stencils-build
STENCILS_H = $(STENCILS_BUILD_DIR)/stencils.h

PKG_CFLAGS += -I$(STENCILS_BUILD_DIR) -I.
PKG_LIBS += $(SHARED_LIB) -lstdc++

SOURCES = $(wildcard *.c)
OBJECTS = $(SOURCES:.c=.o) $(STENCILS_BUILD_DIR)/stencils_data.o rcp_exceptions.o

# Compile stencils-runtime.c with frame pointers so perf can unwind through helpers
stencils-runtime.o: PKG_CFLAGS += -fno-omit-frame-pointer

# `rcp_smc_copy` must leave its `return call()` as a tail *jump*: it overwrites the stencil slot it
# was called from, so if it returns there instead it resumes in the middle of the variant it just
# installed. `R CMD INSTALL` takes CFLAGS from the R build's etc/Makeconf, and an R built with
# DEBUG=1 puts -O0 there, which turns the tail call into `call; leave; ret` and crashes as soon as a
# self-modifying (feedback-recording) stencil runs. Sibling-call optimization is what makes it a
# jump, so ask for it explicitly instead of inheriting whatever the R build chose. This has to
# override CFLAGS rather than add to PKG_CFLAGS, because `ALL_CFLAGS` puts CFLAGS last and the last
# -O wins. (GCC 14 has no `musttail` to assert this with; -O2 also restores the one-instruction
# memcpy+jump that the register contract in stencils-runtime.c relies on.)
stencils-runtime.o: CFLAGS += -O2 -foptimize-sibling-calls

## ------------------------------------------------------------------------
## targets
## ------------------------------------------------------------------------

.PHONY: force_check

all: $(SHLIB)

$(SHLIB): $(SHARED_LIB)

$(OBJECTS): $(STENCILS_H)

# Cancel Makeconf's own `.c.d`/`.cc.d`/`.cpp.d` rules (pattern rules with no recipe cancel), so make
# never tries to *remake* one of the `.d` files below. Ours are written by the compiler during the
# real compile (-MMD above); R's rule re-runs the preprocessor with only ALL_CPPFLAGS, which omits
# the PKG_CFLAGS -I paths, so it can't find runtime.h or the generated stencils.h.
%.d: %.c
%.d: %.cc
%.d: %.cpp

# Header dependencies recorded by -MMD -MP above. `wildcard` so only existing ones are named: on a
# clean tree there are none (everything is built anyway), and naming a `.d` under the not-yet-created
# stencils-build/ makes make resolve stencils_data.o before the extractor has generated its source.
# -MP emits a phony target per header, so deleting one doesn't wedge the build.
-include $(wildcard $(OBJECTS:.o=.d))

$(STENCILS_H): $(EXTRACTOR) $(STENCILS_OBJ) $(STENCIL_DIFF)
	@if [ -f $(STENCILS_BUILD_DIR)/stencils_data.c ]; then \
		mv $(STENCILS_BUILD_DIR)/stencils_data.c $(STENCILS_BUILD_DIR)/stencils_data.c.old; \
	fi
	$(EXTRACTOR) $(STENCILS_OBJ) $(STENCILS_BUILD_DIR)
	@$(STENCIL_DIFF) $(STENCILS_BUILD_DIR)/stencils_data.c.old $(STENCILS_BUILD_DIR)/stencils_data.c || true

$(EXTRACTOR): force_check
	$(MAKE) -C $(EXTRACTOR_DIR)

$(STENCIL_DIFF): force_check
	$(MAKE) -C $(STENCIL_DIFF_DIR)

$(STENCILS_OBJ): force_check
	$(MAKE) -C $(STENCILS_DIR)

$(SHARED_LIB):
	$(MAKE) -C $(SHARED_LIB_DIR)

.PHONY: clean
clean:
	$(MAKE) -C $(EXTRACTOR_DIR) clean
	$(MAKE) -C $(STENCIL_DIFF_DIR) clean
	$(MAKE) -C $(STENCILS_DIR) clean
	$(MAKE) -C $(SHARED_LIB_DIR) clean
	rm -f *.o *.d *.so
	rm -rf $(STENCILS_BUILD_DIR)

