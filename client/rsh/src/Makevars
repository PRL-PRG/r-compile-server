# Set these env vars for macOS
# Also need a custom ~/.R/Makevars which uses clang, -std=c++17, and includes/links homebrew
# LLVM_DIR = /opt/homebrew/Cellar/llvm@17/17.0.6
# LLVM_CONFIG = $(LLVM_DIR)/bin/llvm-config
LLVM_DIR ?= /opt/llvm
LLVM_CONFIG ?= llvm-config-17

LLVM_CPPFLAGS := $(shell $(LLVM_CONFIG) --cxxflags)
LLVM_LIBS := $(shell $(LLVM_CONFIG) --libfiles)

PB_CPPFLAGS := $(shell pkg-config --cflags protobuf)
PB_LIBS := $(shell pkg-config --libs protobuf)
ABSL_CPPFLAGS := $(shell pkg-config --cflags absl_log)
ABSL_LIBS := $(shell pkg-config --libs absl_log)
GRPC_CPPFLAGS := $(shell pkg-config --cflags grpc++)
GRPC_LIBS := $(shell pkg-config --libs grpc++)
XXHASH_CFLAGS := $(shell pkg-config --cflags libxxhash)
XXHASH_LIBS := $(shell pkg-config --libs libxxhash)

# Both C/C++ flags.
# -MMD -MP makes each compile write a `.d` listing the headers it read, which `-include` below
# feeds back to make. Without it nothing here depends on a header, so editing e.g. bc2c/opcodes.h
# silently reuses stale objects -- and an object built against different headers than its
# neighbours usually shows up as a confusing link error, not a rebuild.
PKG_CPPFLAGS := -DR_NO_REMAP -DSTRICT_R_HEADERS -DUSE_RINTERNALS -MMD -MP
# C++ flags
PKG_CXXFLAGS := $(LLVM_CPPFLAGS) $(PB_CPPFLAGS) $(ABSL_CPPFLAGS) $(GRPC_CPPFLAGS) $(XXHASH_CFLAGS) -fexceptions
# C flags
PKG_CFLAGS :=
# Linker flags
PKG_LIBS := $(LLVM_LIBS) $(PB_LIBS) $(ABSL_LIBS) $(GRPC_LIBS) $(XXHASH_LIBS)

# Allow sources in subdirectories
CPP_FILES = $(wildcard *.cpp **/*.cpp)
CC_FILES = $(wildcard *.cc **/*.cc)
C_FILES = $(wildcard *.c **/*.c)

OBJECTS = $(CPP_FILES:.cpp=.o) $(CC_FILES:.cc=.o) $(C_FILES:.c=.o)

# A `.d` starts with an explicit `<obj>:` rule, and this Makevars has no rules of its own, so
# without this the first included one would become make's default goal and `R CMD SHLIB` would
# build a single object instead of the library. `all` is shlib.mk's own default, read after us.
.DEFAULT_GOAL := all

# Cancel Makeconf's own `.c.d`/`.cc.d`/`.cpp.d` rules (pattern rules with no recipe cancel), so make
# never tries to *remake* one of the `.d` files below: ours are written by the compiler during the
# real compile (-MMD above), with the flags the object was actually built with.
%.d: %.c
%.d: %.cc
%.d: %.cpp

# Header dependencies recorded by -MMD -MP above. `wildcard` so only existing ones are named: on a
# clean tree there are none, and everything is built anyway. -MP emits a phony target per header, so
# deleting one doesn't wedge the build.
-include $(wildcard $(OBJECTS:.o=.d))

